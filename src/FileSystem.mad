import type { Wish } from "Wish"

import Dir from "Directory"
import File from "File"
import IO from "IO"
import Wish from "Wish"



export alias DirEnt = { directory :: Boolean, fullPath :: String, name :: String, path :: String }

#iftarget js

#- import fs from "node:fs" -#
#- import path from "node:path" -#

status :: ((a -> {}) -> (c -> {}) -> a -> b -> c) -> String -> Wish a c
export status = (transform, filePath) => Wish.Wish(
  (b, g) => {
    #- fs.lstat(filePath, (e, x) => transform(b)(g)(e)(x)) -#
    return () => {}
  },
)


isDirectory :: String -> Wish a Boolean
export isDirectory = status((b, g, e, x) => #- e ? g(false) : g(x.isDirectory()) -#)
// /*
